# Flutter Web is the homepage. The PHP API lives in backend/.
Options -Indexes -MultiViews
DirectoryIndex index.html
AddType application/wasm .wasm
AddType application/javascript .js

<IfModule mod_headers.c>
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Embedder-Policy "require-corp"
    Header always set X-Content-Type-Options "nosniff"
    <FilesMatch "\.(?:html|js|wasm|json)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

<FilesMatch "(?i)(^\.|^keys\.env(?:\..*)?$|\.(?:sqlite3?|db|zip|env)$)">
    Require all denied
</FilesMatch>

RewriteEngine On
RewriteBase /projects/VoxLingo/
# Never expose project sources, old Node files, tests or generated artifacts.
RewriteRule ^(?:lib|test|tool|build|android|ios|windows|linux|macos)(?:/|$) - [F,L]
# Compatibility for previously installed desktop/mobile clients.
RewriteRule ^(?:index\.php|translation/?)$ backend/index.php [L]
RewriteRule ^services/(?:stt/transcribe|tts/synthesize)/?$ backend/index.php [L]
